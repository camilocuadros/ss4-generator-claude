# SS-4 Form Filler - Environment Variables Example
# Copia este archivo a .env y ajusta los valores según tu configuración

# Ruta al template del formulario SS-4 (PDF del IRS)
TEMPLATE_PATH=/app/templates/1_updated_fss4.pdf

# Ruta al archivo de mapeo de campos
MAPPING_PATH=/app/ss4_field_mapping.json

# Directorio de salida (opcional - por defecto usa /tmp)
# OUTPUT_DIR=/app/outputs

# Puerto del servidor (opcional - por defecto 8000)
# PORT=8000

# === Configuración de CORS (opcional) ===
# Descomenta y configura si necesitas acceso desde un frontend específico
# CORS_ORIGINS=https://tu-frontend.com,https://www.tu-frontend.com

# === Para desarrollo local ===
# Si estás desarrollando localmente, ajusta las rutas:
# TEMPLATE_PATH=./templates/1_updated_fss4.pdf
# MAPPING_PATH=./ss4_field_mapping.json
